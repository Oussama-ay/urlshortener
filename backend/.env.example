# Backend database configuration
DB_URL="jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require"
DB_USERNAME=neondb_owner
DB_PASSWORD=YOUR_NEON_PASSWORD

# Backend runtime configuration
REDIS_URL="rediss://default:YOUR_UPSTASH_TOKEN@YOUR_UPSTASH_HOST:6379"
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173

# JWT signing key: generate with openssl rand -base64 32
JWT_SECRET=YOUR_GENERATED_BASE64_SECRET
JWT_EXPIRATION=86400000
